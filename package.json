{
  "name": "local-duckdb-datasource",
  "version": "0.1.0",
  "private": true,
  "description": "Local DuckDB and DuckLake data source for Grafana",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "e2e": "playwright test",
    "format": "prettier --write src webpack.config.cjs tsconfig.json package.json",
    "lint": "prettier --check src webpack.config.cjs tsconfig.json package.json"
  },
  "dependencies": {
    "@grafana/data": "12.4.0",
    "@grafana/runtime": "12.4.0",
    "@grafana/schema": "12.4.0",
    "@grafana/ui": "12.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "copy-webpack-plugin": "13.0.0",
    "esbuild-loader": "4.3.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "webpack": "5.99.9",
    "webpack-cli": "6.0.1"
  }
}

      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "local-duckdb-datasource",
            "uid": "local-duckdb"
          },
          "rawSql": "SELECT $__timeGroupAlias(time, '$__interval'), device, avg(value) AS value FROM example_metrics WHERE $__timeFilter(time) AND device IN (${device:sqlstring}) GROUP BY 1, 2 ORDER BY 1",

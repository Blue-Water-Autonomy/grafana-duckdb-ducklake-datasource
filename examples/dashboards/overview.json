    {
      "id": 21,
      "type": "timeseries",
      "title": "Embedded DuckDB \u00b7 inline SQL",
      "description": "Inline setup SQL creates a view over local Parquet batches published every five seconds.",
      "datasource": {
        "type": "local-duckdb-datasource",
        "uid": "local-duckdb"
      },
      "gridPos": {
        "x": 0,

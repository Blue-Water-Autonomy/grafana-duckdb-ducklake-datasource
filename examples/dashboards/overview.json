  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Four configurations, live data",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Three sensors report temperatures across all four data sources. Use **Device** to filter every panel. Both embedded DuckDB examples query new Parquet batches; both DuckLake examples receive new rows. The ingestion service publishes fresh measurements every five seconds."
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Inline SQL rows",
      "description": "Inline setup SQL creates a view over local Parquet batches published every five seconds.",
      "datasource": {
        "type": "local-duckdb-datasource",
        "uid": "local-duckdb"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "local-duckdb-datasource",
            "uid": "local-duckdb"
          },
          "rawSql": "SELECT count(*) AS samples FROM example_metrics WHERE $__timeFilter(time) AND device IN (${device:sqlstring})",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short"

    {
      "id": 30,
      "type": "table",
      "title": "Latest ingested measurements \u00b7 TLS catalog",
      "datasource": {
        "type": "local-duckdb-datasource",
        "uid": "example-ducklake-tls"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "local-duckdb-datasource",
            "uid": "example-ducklake-tls"
          },
          "rawSql": "SELECT time, device, round(value, 2) AS temperature FROM measurements WHERE $__timeFilter(time) AND device IN (${device:sqlstring}) ORDER BY time DESC, device LIMIT 12",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
